  "info": {
    "title": "finanzas-app API",
    "description": "API REST de finanzas personales",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorRespuesta": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "PERFIL_REQUERIDO"
          },
          "mensaje": {
            "type": "string"
          }
        },
        "required": [
          "codigo",
          "mensaje"
        ]
      },
      "CrearPerfilDto": {
        "type": "object",
        "properties": {
          "moneda": {
            "type": "string",
            "example": "PEN",
            "description": "Código ISO 4217"
          },
          "zonaHoraria": {
            "type": "string",
            "example": "America/Lima",
            "description": "Zona horaria IANA"
          }
        },
        "required": [
          "moneda",
          "zonaHoraria"
        ]
      },
      "PerfilRespuesta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "moneda": {
            "type": "string",
            "example": "PEN"
          },
          "zonaHoraria": {
            "type": "string",
            "example": "America/Lima"
          }
        },
        "required": [
          "id",
          "moneda",
          "zonaHoraria"
        ]
      },
      "ActualizarPerfilDto": {
        "type": "object",
        "properties": {
          "moneda": {
            "type": "string",
            "example": "PEN"
          },
          "zonaHoraria": {
            "type": "string",
            "example": "America/Lima"
          }
        }
      },
      "CrearCategoriaDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "tipo": {
            "type": "string",
            "enum": [
              "gasto",
              "ingreso"
            ]
          }
        },
        "required": [
          "nombre",
          "tipo"
        ]
      },
      "CategoriaRespuesta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "gasto",
              "ingreso"
            ]
          },
          "cantidadMovimientos": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "id",
          "nombre",
          "tipo",
          "cantidadMovimientos"
        ]
      },
      "RenombrarCategoriaDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "required": [
          "nombre"
        ]
      },
      "CrearTransaccionDto": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "gasto",
              "ingreso"
            ]
          },
          "monto": {
            "type": "string",
            "example": "12.50",
            "description": "Mayor que 0, hasta 2 decimales, como string"
          },
          "fecha": {
            "type": "string",
            "example": "2026-11-19",
            "description": "YYYY-MM-DD"
          },
          "descripcion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "categoriaId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "tipo",
          "monto",
          "fecha",
          "descripcion",
          "categoriaId"
        ]
      },
      "TransaccionRespuesta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "gasto",
              "ingreso"
            ]
          },
          "monto": {
            "type": "string",
            "example": "12.50",
            "description": "Siempre con 2 decimales"
          },
          "fecha": {
            "type": "string",
            "example": "2026-11-19",
            "description": "YYYY-MM-DD"
          },
          "descripcion": {
            "type": "string"
          },
          "categoriaId": {
            "type": "string",
            "format": "uuid",
